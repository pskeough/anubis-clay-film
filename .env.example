# Copy to .env at the repo root (or set these in your shell). Every value is optional; an empty
# value leaves the default in place, and the defaults are repo-relative.
#
# Read by the CLI, the MCP server, the studio and the voice booth (clay_film/envfile.py) and by
# farm/farm.ps1 and farm/phase.ps1 (farm/envfile.ps1). A variable already set in the shell always
# wins. A value starting with ./ or ../ is relative to the repo root; any other relative path is
# relative to the folder the reading process runs in. Quotes, `export KEY=...` and " # comments"
# are handled. The .bat launchers do not read this file: set CLAY_FILM_PY / CLAY_FILM_PODCAST_PY in
# the shell for them.
CLAY_FILM_PIECES=./pieces              # where pieces (plan, stills, clips, film) are written
CLAY_FILM_ROKO=./filmprep              # clay blockout prep (TypeScript, run with npx tsx)
CLAY_FILM_LIB=./pipeline_lib           # narrate / animate / assemble scripts
CLAY_FILM_FARM=./farm                  # ComfyUI worker farm
CLAY_FILM_PY=python                    # Python for the CLI, studio and farm
CLAY_FILM_PODCAST_PY=python            # Python env with torch, kokoro, faster-whisper, imageio-ffmpeg
CLAY_FILM_TTS_ENGINE=./tts_engine
COMFY_ROOT=C:\ComfyUI                  # ComfyUI install that holds the diffusion models
COMFY_EXTRA_MODELS=                    # optional extra model folder for preflight checks
AUDIOCPP_CLI=audiocpp_cli.exe          # audio.cpp CLI for Qwen3-TTS GGUF
QWEN3TTS_BASE_GGUF=models/qwen3-tts-12hz-1.7b-base-q8_0.gguf
QWEN3TTS_VOICEDESIGN_GGUF=models/qwen3-tts-voicedesign-q8_0.gguf
CLAY_FILM_LLM_SCRIPT=                  # optional script that starts/stops a local LLM sharing the GPUs
CAPTION_FONTS_DIR=C:\Windows\Fonts
FFMPEG=                                # optional explicit ffmpeg path
ASSET_LIBRARY=                         # optional mesh library for space.json props that name an `asset`
CLAY_FILM_ADAPTATIONS=./adaptations    # director mode: one folder per adaptation with its direction.json
CLAY_FILM_DIRECTOR_KB=./director_kb    # optional markdown knowledge base for clay_film.director_kb (not shipped)
CLAY_FILM_STILL_MODEL=                 # Qwen-Image-2.1 transformer for stills/end frames: base | turbo | turbo_simple
CLAY_FILM_H3_SINGLE_GPU=               # 1: send H3 the plain one-card graph (always on for remote workers)
CLAY_FIGURE_FRAME=                     # 1: frame person shots on the body part the size names (off: whole figure)
FARM_EXTRA_ARGS=                       # extra ComfyUI flags for the pinned pair, e.g. --disable-pinned-memory
FARM_REMOTE_WORKERS=                   # remote H3 ComfyUIs over SSH tunnels: name:port or name@host:port, comma-separated
VOICE_BOOTH_PORT=7090                  # voice booth http port (127.0.0.1 only)
VOICE_EDIT_SEED_CUES=                  # optional seed cut csv for the voice editor (default <piece>/voice/seed_cues.csv)
# Finishing tools (finishing/README.md), only if you use them:
RIFE_ARCH_DIR=                         # ComfyUI-Frame-Interpolation/vfi_models/rife (holds rife_arch.py)
RIFE_WEIGHTS=                          # rife426.pth
SA3_MODEL=medium                       # Stable Audio 3 model for finishing/score.py
LATENTSYNC_ROOT=                       # LatentSync checkout for finishing/lipsync.py
LATENTSYNC_PY=                         # its venv python (default LATENTSYNC_ROOT/.venv)
LATENTSYNC_CKPT=                       # optional unet checkpoint override
INSIGHTFACE_ROOT=                      # folder holding models/buffalo_l (default LATENTSYNC_ROOT/checkpoints/auxiliary)
# Testing without models:
CLAY_FILM_DRY=                         # 1: fake every GPU job (stills, clips, narration)
CLAY_FILM_DRY_FIXTURE=                 # a finished piece to copy dry stills/clips from (dry clips need one)
CLAY_FILM_DRY_SCALE=                   # multiplies the dry delays (0 for tests)
# Planner endpoint keys (only if you plan with a hosted model):
CLAY_FILM_API_KEY=
OPENROUTER_API_KEY=
